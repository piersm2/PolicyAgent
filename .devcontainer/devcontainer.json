{
  "name": "Payer Policy Watch",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "npm install && npx playwright-core install --with-deps chromium",
  "postAttachCommand": "npm install --no-audit --no-fund && npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Payer Policy Watch",
      "onAutoForward": "openBrowser"
    }
  }
}
